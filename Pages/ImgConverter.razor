@page "/projects/imgConverter"
@* Page Title *@
<PageTitle>Image Converter</PageTitle>

@* Import CSS *@
<link rel="stylesheet" href="css/imageConverter.css" />

@* External JS libraries *@
<script src="https://cdn.jsdelivr.net/npm/jszip@3.7.1/dist/jszip.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/heic2any@0.0.3/dist/heic2any.min.js"></script>

<!-- Drop Zone -->
<div id="drop-zone" class="drop-zone">
    Drag & Drop Images Here or Click to Browse
    <input type="file" id="file-input" multiple accept="image/*" hidden />
</div>

<!-- Fullscreen Preview -->
<div class="preview-wrapper hidden" id="preview-wrapper">
    <!-- Original Image -->
    <img id="preview-image-original" alt="Original Preview" />
    <!-- Converted Image -->
    <img id="preview-image-converted" alt="Converted Preview" />

    <!-- Top Right Controls (Download Dropdown) -->
    <div class="top-right-controls">
        <div class="dropdown">
            <button id="download-btn" class="btn glass-panel">
                Download
                <span id="download-arrow" class="dropdown-arrow" aria-label="Toggle dropdown" role="button" tabindex="0">▼</span>
            </button>
            <div class="dropdown-menu">
                <button id="download-all-btn" class="btn glass-panel">Download All</button>
            </div>
        </div>
    </div>

    <!-- Bottom left: Original File Size Label -->
    <div class="bottom-left-label glass-panel" id="original-file-size">Original</div>
    <!-- Bottom right: Converted File Size Label -->
    <div class="bottom-left-label glass-panel" id="converted-file-size">Converted</div>

    <!-- Bottom Right Controls -->
    <div class="bottom-right-controls glass-panel">
        <div class="custom-select" tabindex="0" aria-labelledby="selected-format-label">
            <div id="selected-format" class="selected-option">
                JPEG
            </div>

            <div class="options-list">
                <span class="option-item" data-value="webp">WebP</span>
                <span class="option-item" data-value="jpeg" aria-selected="true">JPEG</span>
                <span class="option-item" data-value="png">PNG</span>
            </div>

            <input type="hidden" name="format-select" id="format-select" class="selectOutput" value="jpeg" />
        </div>

        <label for="compress-slider">Quality:</label>
        <input type="range" id="compress-slider" min="0" max="100" value="80" />
    </div>

    <!-- Vertical Reveal Slider -->
    <div id="reveal-slider-vertical" class="reveal-slider-vertical"></div>
</div>

<!-- Prev / Next side buttons -->
<button id="prev-btn" class="side-btn hidden glass-panel">&larr;</button>
<button id="next-btn" class="side-btn hidden glass-panel">&rarr;</button>

<!-- Controls -->
<div class="controls hidden glass-panel">
    <label for="zoom-range">Zoom:</label>
    <input type="range" id="zoom-range" min="10" max="300" value="100" />
    <span id="image-counter" style="margin-left: 12px; font-weight: bold;"></span>
</div>

@code {
    // If you need to call JavaScript functions (imgConverter.js)
    // you can inject IJSRuntime and call it here.
    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load your imgConverter.js
            await JS.InvokeVoidAsync("import", "./js/imgConverter.js");
        }
    }
}
