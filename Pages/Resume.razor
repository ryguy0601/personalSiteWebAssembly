@page "/AboutMe/Resume"

<PageTitle>Resume</PageTitle>

<style>
    /* You can move this to Resume.razor.css (recommended) */
    .text-gradient {
        background: linear-gradient(90deg, #ff4fa3, #ff00ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .resume { color: #e6e6e6; }
    .section-title {
        border-left: 4px solid #ff4fa3;
        padding-left: 0.6rem;
        margin-bottom: 1.5rem;
        font-weight: 600;
        color: #fff;
    }
    .skill-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        background: rgba(255,255,255,0.05);
    }
    .skill-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0,0,0,1);
    }
    a { text-decoration: none; }
</style>

<section class="resume container py-5">
    <header class="mb-5 text-center">
        <h1 class="display-4 fw-bold text-gradient">@Name</h1>
        <p class="lead mb-3">
            <a class="link-light" href="mailto:@Email">@Email</a>
            <span class="mx-2">•</span>
            <a class="link-light" href="tel:@PhoneRaw">@Phone</a>
            <span class="mx-2">•</span>
            <span>@Location</span>
        </p>
        <p>
            <a class="btn btn-outline-light btn-sm me-2" href="@LinkedInUrl" target="_blank" rel="noopener">
                <i class="bi bi-linkedin"></i> LinkedIn
            </a>
            <a class="btn btn-outline-light btn-sm" href="@GithubUrl" target="_blank" rel="noopener">
                <i class="bi bi-github"></i> GitHub
            </a>
        </p>
    </header>

    <section class="mb-5">
        <h2 class="section-title">Summary</h2>
        <p class="fs-5">@Summary</p>
    </section>

    <section class="mb-5">
        <h2 class="section-title">Skills</h2>
        <div class="row g-4">
            @foreach (var group in SkillGroups)
            {
                <div class="col-md-4">
                    <div class="card border-0 shadow-lg skill-card h-100">
                        <div class="card-body">
                            <h3 class="h6 text-uppercase text-gradient fw-bold">@group.Title</h3>
                            <ul class="list-unstyled mb-0">
                                @foreach (var item in group.Items)
                                {
                                    <li>• @item</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="mb-5">
        <h2 class="section-title">Work Experience</h2>
        @foreach (var job in WorkExperience)
        {
            <article class="mb-5 p-4 rounded shadow-sm bg-dark bg-opacity-25">
                <div class="d-flex flex-wrap align-items-baseline justify-content-between">
                    <h3 class="h5 fw-bold">@job.Title</h3>
                    <span class="text-gradient">@job.DateRange</span>
                </div>
                <div class="d-flex flex-wrap align-items-baseline justify-content-between">
                    <span>@job.Company</span>
                    @* <span class="text-gradient">@job.Location</span> *@
                </div>
                <div class="mb-2">@job.Company</div>
                <ul class="ps-3">
                    @foreach (var bullet in job.Bullets)
                    {
                        <li class="mb-1"><i class="bi bi-caret-right-fill text-gradient me-1"></i>@bullet</li>
                    }
                </ul>
            </article>
        }
    </section>

    <section class="mb-5">
        <h2 class="section-title">Education</h2>
        @foreach (var learn in Education)
        {
            <article class="mb-5 p-4 rounded shadow-sm bg-dark bg-opacity-25">
                <div class="d-flex flex-wrap align-items-baseline justify-content-between">
                    <h3 class="h5 fw-bold">@learn.School</h3>
                    <span class="text-gradient">@learn.DateRange</span>
                </div>
                <div class="d-flex flex-wrap align-items-baseline justify-content-between">
                    <span>@learn.DegreeAndMajor</span>
                    <span class="text-gradient">@learn.Location</span>
                </div>
                @if (learn.Courses is not null && learn.Courses.Count > 0)
                {
                    <ul class="p-3">
                        @foreach (var bullet in learn.Courses)
                        {
                            <li class="mb-1"><i class="bi bi-caret-right-fill text-gradient me-1"></i>@bullet</li>
                        }
                    </ul>
                }
            </article>
        }
    </section>
</section>

