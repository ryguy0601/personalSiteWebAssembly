@page "/Games/new2048"

<PageTitle>2048</PageTitle>

<link rel="stylesheet" href="css/new2048.css" />

<div id="gameContainer">
    <div id="game">
        <div id="scoreContainer">
            <div id="score">
                Score: 0
            </div>
            <div id="addedScoreHolder">
                <div id="addedScore">
                    <!-- so the space doesnt change -->
                    &emsp;
                </div>
            </div>
        </div>
        <div id="grid">
            <!-- row 1 -->
            <div class="tile" id="cord-0-0"><div class="tile-0"></div></div>
            <div class="tile" id="cord-0-1"><div class="tile-0"></div></div>
            <div class="tile" id="cord-0-2"><div class="tile-0"></div></div>
            <div class="tile" id="cord-0-3"><div class="tile-0"></div></div>

            <!-- row 2 -->
            <div class="tile" id="cord-1-0"><div class="tile-0"></div></div>
            <div class="tile" id="cord-1-1"><div class="tile-0"></div></div>
            <div class="tile" id="cord-1-2"><div class="tile-0"></div></div>
            <div class="tile" id="cord-1-3"><div class="tile-0"></div></div>

            <!-- row 3 -->
            <div class="tile" id="cord-2-0"><div class="tile-0"></div></div>
            <div class="tile" id="cord-2-1"><div class="tile-0"></div></div>
            <div class="tile" id="cord-2-2"><div class="tile-0"></div></div>
            <div class="tile" id="cord-2-3"><div class="tile-0"></div></div>

            <!-- row 4 -->
            <div class="tile" id="cord-3-0"><div class="tile-0"></div></div>
            <div class="tile" id="cord-3-1"><div class="tile-0"></div></div>
            <div class="tile" id="cord-3-2"><div class="tile-0"></div></div>
            <div class="tile" id="cord-3-3"><div class="tile-0"></div></div>
        </div>
        <button id="restartButton">Restart</button>
    </div>
</div>

<script src="js/new2048.js"></script>


